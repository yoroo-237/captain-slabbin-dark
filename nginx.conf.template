worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 256; }

http {
  include /etc/nginx/mime.types;
  server_tokens off;
  access_log off;   # pas de logs de visiteurs

  resolver 1.1.1.1 8.8.8.8 valid=60s ipv6=off;

  server {
    # Ecoute uniquement en local : Tor est le seul point d'entree.
    listen 127.0.0.1:8080;

    # Reecriture des URLs dans les reponses (HTML, JS, JSON, CSS).
    # Requiert une reponse non compressee : Accept-Encoding vide plus bas.
    sub_filter_once off;
    sub_filter_types *;

    # --- robots.txt et sitemap.xml : URLs reecrites vers l'adresse onion ---
    location ~ ^/(robots\.txt|sitemap\.xml)$ {
      set $upstream "https://${UPSTREAM_HOST}";
      proxy_pass $upstream;

      proxy_ssl_server_name on;
      proxy_ssl_name ${UPSTREAM_HOST};
      proxy_set_header Host ${UPSTREAM_HOST};
      proxy_set_header Accept-Encoding "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Real-IP "";
      proxy_set_header Forwarded "";

      sub_filter 'https://www.${ROOT_HOST}' 'http://$host';
      sub_filter 'https://${ROOT_HOST}' 'http://$host';

      proxy_connect_timeout 10s;
      proxy_read_timeout 60s;
    }

    # --- API : /_api/... est relaye vers https://${API_HOST}/... ---
    location /_api/ {
      set $api "https://${API_HOST}";
      rewrite ^/_api/(.*)$ /$1 break;
      proxy_pass $api;

      proxy_ssl_server_name on;
      proxy_ssl_name ${API_HOST};
      proxy_set_header Host ${API_HOST};
      # L'API refuse (500) les origines inconnues : on presente l'origine clearnet autorisee.
      proxy_set_header Origin "https://${ROOT_HOST}";
      proxy_set_header Referer "https://${ROOT_HOST}/";
      proxy_set_header Accept-Encoding "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Real-IP "";
      proxy_set_header Forwarded "";

      sub_filter 'https://${API_HOST}' '/_api';
      sub_filter 'https://www.${ROOT_HOST}' 'http://$host';
      sub_filter 'https://${ROOT_HOST}' 'http://$host';

      proxy_cookie_domain ${API_HOST} $host;
      proxy_connect_timeout 10s;
      proxy_read_timeout 60s;
    }

    # --- Site : tout le reste ---
    location / {
      # Variable => nginx re-resout le DNS (utile si l'IP du site clearnet change).
      set $upstream "https://${UPSTREAM_HOST}";
      proxy_pass $upstream;

      proxy_ssl_server_name on;
      proxy_ssl_name ${UPSTREAM_HOST};
      proxy_set_header Host ${UPSTREAM_HOST};
      proxy_set_header Accept-Encoding "";

      # Ne transmet aucune info sur le visiteur.
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Real-IP "";
      proxy_set_header Forwarded "";

      # Les appels vers l'API passent par l'onion (meme origine, pas de CORS).
      sub_filter 'https://${API_HOST}' '/_api';
      sub_filter 'https://www.${ROOT_HOST}' 'http://$host';
      sub_filter 'https://${ROOT_HOST}' 'http://$host';

      # Garde les redirections et cookies sur l'onion.
      proxy_redirect https://${UPSTREAM_HOST}/ /;
      proxy_redirect https://${ROOT_HOST}/ /;
      proxy_cookie_domain ${UPSTREAM_HOST} $host;

      proxy_connect_timeout 10s;
      proxy_read_timeout 60s;
    }
  }
}
