worker_processes 1;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 256; }

http {
  include /etc/nginx/mime.types;
  server_tokens off;
  access_log off;   # pas de logs de visiteurs

  resolver 1.1.1.1 8.8.8.8 valid=60s ipv6=off;

  server {
    # Ecoute uniquement en local : Tor est le seul point d'entree.
    listen 127.0.0.1:8080;

    location / {
      # Variable => nginx re-resout le DNS (utile si l'IP du site clearnet change).
      set $upstream "https://${UPSTREAM_HOST}";
      proxy_pass $upstream;

      proxy_ssl_server_name on;
      proxy_ssl_name ${UPSTREAM_HOST};
      proxy_set_header Host ${UPSTREAM_HOST};

      # Ne transmet aucune info sur le visiteur.
      proxy_set_header X-Forwarded-For "";
      proxy_set_header X-Real-IP "";
      proxy_set_header Forwarded "";

      # Garde les redirections et cookies sur l'onion.
      proxy_redirect https://${UPSTREAM_HOST}/ /;
      proxy_cookie_domain ${UPSTREAM_HOST} $host;

      proxy_connect_timeout 10s;
      proxy_read_timeout 60s;
    }
  }
}
